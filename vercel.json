{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/src/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "server/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "client/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/client/index.html",
      "permanent": false
    }
  ]
}
